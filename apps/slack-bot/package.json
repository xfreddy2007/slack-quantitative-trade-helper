{
  "name": "slack-bot",
  "version": "0.1.0",
  "description": "Slack-based quantitative investment assistant bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx src/db/seed.ts",
    "pipeline:fixture": "tsx src/orchestration/pipelineFixture.ts",
    "backtest:fixtures": "tsx src/orchestration/backtestFixtures.ts",
    "quality-gate": "tsx src/orchestration/qualityGate.ts"
  },
  "prisma": {
    "schema": "../../db/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@slack/bolt": "^3.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
