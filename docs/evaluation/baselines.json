        "recall":      { "path": "totals.recall",           "baseline": 0.889, "direction": "higher", "epsilon": 0.12, "gated": true },
        "fpRate":      { "path": "totals.fpRate",           "baseline": 0.20,  "direction": "lower",  "epsilon": 0.15, "gated": true },
        "brier":       { "path": "brier",                   "baseline": 0.127, "direction": "lower",  "epsilon": 0.05, "gated": true },
